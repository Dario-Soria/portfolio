---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CursorLabel from '../components/CursorLabel.astro';
import { projects } from '../data/projects';
import { url } from '../lib/url';

// Every photo on the home grid: each project's cover first, then the rest of its images.
const tiles = projects.flatMap((p) => [
  { project: p, src: p.cover, alt: p.title, position: p.coverPosition, first: true },
  ...p.images
    .filter((photo) => photo.src.src !== p.cover.src)
    .map((photo) => ({ project: p, src: photo.src, alt: photo.alt, position: undefined, first: false })),
]);
---

<Base>
  <main class="page">
    <h1 class="sr-only">Selected work</h1>
    <ul class="grid4 cards">
      {
        tiles.map((t, i) => (
          <li class="fade-in" style={`animation-delay:${Math.min(i, 12) * 50}ms`}>
            <a class="card" href={url(`work/${t.project.slug}/`)} data-cursor={t.project.title}>
              <Image
                src={t.src}
                alt={t.alt}
                widths={[480, 800, 1200]}
                sizes="(max-width: 560px) 50vw, (max-width: 1000px) 50vw, 25vw"
                loading={i < 4 ? 'eager' : 'lazy'}
                style={t.position ? `object-position:${t.position}` : undefined}
              />
              {t.first && (
                <span class="card-title">
                  <span>{t.project.title}</span>
                  <span class="muted">{t.project.year}</span>
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <CursorLabel />
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--pill);
  }
  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover :global(img) {
    transform: scale(1.025);
  }
  /* Title row only shown on touch devices (desktop uses the cursor label) */
  .card-title {
    display: none;
  }
  .muted {
    color: var(--muted);
  }
  @media (hover: none) {
    .card-title {
      position: absolute;
      left: 10px;
      right: 10px;
      bottom: 10px;
      display: flex;
      justify-content: space-between;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(243, 243, 243, 0.85);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }
</style>
