---
// Fullscreen viewer for `.shot` buttons (needs data-full, data-alt, data-index).
---

<dialog class="lightbox" aria-label="Image viewer">
  <img class="lb-img" alt="" />
  <p class="lb-caption pill"></p>
  <button class="lb-btn lb-close pill" aria-label="Close">Close ✕</button>
  <button class="lb-btn lb-prev pill" aria-label="Previous image">◂</button>
  <button class="lb-btn lb-next pill" aria-label="Next image">▸</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
  const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
  const shots = [...document.querySelectorAll<HTMLElement>('.shot')];
  let index = 0;

  const show = (i: number) => {
    index = (i + shots.length) % shots.length;
    const s = shots[index];
    img.src = s.dataset.full!;
    img.alt = s.dataset.alt!;
    caption.textContent = `${index + 1} / ${shots.length} — ${s.dataset.alt}`;
  };

  shots.forEach((s, i) =>
    s.addEventListener('click', () => {
      show(i);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  dialog.addEventListener('close', () => (document.documentElement.style.overflow = ''));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  const hideNav = shots.length < 2;
  dialog.querySelectorAll<HTMLElement>('.lb-prev, .lb-next').forEach((b) => (b.hidden = hideNav));
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.96);
    display: none;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb 0.25s ease both;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  @keyframes lb {
    from {
      opacity: 0;
    }
  }
  .lb-img {
    max-width: calc(100vw - 140px);
    max-height: calc(100vh - 110px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 14px;
  }
  .lb-btn {
    position: fixed;
  }
  .lb-close {
    top: var(--gap);
    right: var(--gap);
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    justify-content: center;
  }
  .lb-prev {
    left: var(--gap);
  }
  .lb-next {
    right: var(--gap);
  }
  .lb-caption {
    position: fixed;
    bottom: var(--gap);
    left: 50%;
    transform: translateX(-50%);
    max-width: calc(100vw - 2 * var(--gap));
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lb-btn[hidden] {
    display: none;
  }
  @media (max-width: 560px) {
    .lb-img {
      max-width: 100vw;
      border-radius: 0;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: calc(var(--gap) * 2 + var(--pill-h));
      transform: none;
    }
  }
</style>
